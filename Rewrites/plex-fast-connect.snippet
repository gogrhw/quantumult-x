; Plex Fast Connect
;
; Uses automatic Plex server discovery and a fixed 3-second probe timeout.
; The request rule removes cache validators. The response rule probes cached
; direct connections and replaces the resource XML.

hostname = plex.tv

^https:\/\/plex\.tv\/api\/resources(?:\.xml)?(?:\?.*)?$ url script-request-header https://raw.githubusercontent.com/gogrhw/quantumult-x/refs/heads/main/Scripts/plex-fast-connect.js
^https:\/\/plex\.tv\/api\/resources(?:\.xml)?(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/gogrhw/quantumult-x/refs/heads/main/Scripts/plex-fast-connect.js
